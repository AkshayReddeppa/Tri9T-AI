        {
          "name": "Get node detail — Battery Life (v1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('body mentions 300 cycles (v1 text)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.body).to.include('300');",
                  "    pm.expect(j.body).to.include('15');",
                  "});",
                  "pm.test('has content hash', () => {",
                  "    pm.expect(pm.response.json().content_hash).to.be.a('string').with.lengthOf(64);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/nodes/{{battery_v1_node_id}}",
              "host": ["{{base_url}}"],
              "path": ["nodes", "{{battery_v1_node_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Diff — Battery Life across v1 and v2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('battery life changed', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.changed).to.be.true;",
                  "    pm.expect(j.hunks.length).to.be.above(0);",
                  "});",
                  "pm.test('diff shows 300 -> 250', () => {",
                  "    const hunks = pm.response.json().hunks;",
                  "    const allLines = hunks.flatMap(h => h.lines).join(' ');",
                  "    pm.expect(allLines).to.match(/-.*300/);",
                  "    pm.expect(allLines).to.match(/\\+.*250/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/nodes/{{battery_v1_node_id}}/diff",
              "host": ["{{base_url}}"],
              "path": ["nodes", "{{battery_v1_node_id}}", "diff"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Selections — version-pinned",
      "item": [
        {
          "name": "Create selection — Battery Life (v1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('selection created', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('battery_selection_id', j.id);",
                  "    pm.expect(j.items.length).to.eql(1);",
                  "});",
                  "pm.test('snapshot preserved v1 text (300 cycles)', () => {",
                  "    const item = pm.response.json().items[0];",
                  "    pm.expect(item.body).to.include('300');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"battery-v1-qa\",\n  \"node_ids\": [\"{{battery_v1_node_id}}\"]\n}"
            },
            "url": { "raw": "{{base_url}}/selections", "host": ["{{base_url}}"], "path": ["selections"] }
          },
          "response": []
        },
        {
          "name": "Create selection — Overpressure (v1)",
          "event": [
