        {
          "name": "Idempotency — resubmit without force returns cache hit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cache hit on resubmit', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.cache_hit).to.be.true;",
                  "    pm.expect(j.id).to.eql(pm.collectionVariables.get('battery_generation_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/selections/{{battery_selection_id}}/generate",
              "host": ["{{base_url}}"],
              "path": ["selections", "{{battery_selection_id}}", "generate"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Staleness — the core demo",
      "item": [
        {
          "name": "★ Battery staleness — expect STALE / CRITICAL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('battery life is stale', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.overall_status).to.eql('stale');",
                  "});",
                  "pm.test('severity is critical (not minor)', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.overall_severity).to.eql('critical');",
                  "});",
                  "pm.test('reason = numeric_threshold_changed', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.nodes[0].reason).to.eql('numeric_threshold_changed');",
                  "});",
                  "pm.test('hashes differ v1 -> v2', () => {",
                  "    const node = pm.response.json().nodes[0];",
                  "    pm.expect(node.snapshot_hash).to.not.eql(node.current_hash);",
                  "});",
                  "pm.test('snapshot is from v1', () => {",
                  "    const node = pm.response.json().nodes[0];",
                  "    pm.expect(node.snapshot_version_id).to.not.eql(node.current_node_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/generations/{{battery_generation_id}}/staleness",
              "host": ["{{base_url}}"],
              "path": ["generations", "{{battery_generation_id}}", "staleness"]
            }
          },
          "response": []
        },
        {
          "name": "★ Overpressure staleness — expect FRESH / NONE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('overpressure is fresh', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.overall_status).to.eql('fresh');",
                  "});",
                  "pm.test('severity is none', () => {",
                  "    pm.expect(pm.response.json().overall_severity).to.eql('none');",
                  "});",
                  "pm.test('hashes identical v1 == v2', () => {",
                  "    const node = pm.response.json().nodes[0];",
                  "    pm.expect(node.snapshot_hash).to.eql(node.current_hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/generations/{{overpressure_generation_id}}/staleness",
              "host": ["{{base_url}}"],
              "path": ["generations", "{{overpressure_generation_id}}", "staleness"]
            }
          },
          "response": []
        },
        {
          "name": "Bulk — all generations with staleness summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns array', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Array.isArray(pm.response.json())).to.be.true;",
                  "});",
                  "pm.test('battery in list is stale', () => {",
                  "    const batteryId = pm.collectionVariables.get('battery_generation_id');",
                  "    const row = pm.response.json().find(r => r.id === batteryId);",
                  "    pm.expect(row).to.exist;",
                  "    pm.expect(row.overall_status).to.eql('stale');",
                  "    pm.expect(row.overall_severity).to.eql('critical');",
                  "});",
                  "pm.test('overpressure in list is fresh', () => {",
                  "    const opId = pm.collectionVariables.get('overpressure_generation_id');",
                  "    const row = pm.response.json().find(r => r.id === opId);",
                  "    pm.expect(row).to.exist;",
                  "    pm.expect(row.overall_status).to.eql('fresh');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/generations", "host": ["{{base_url}}"], "path": ["generations"] }
          },
          "response": []
        },
        {
          "name": "Full generation record — includes embedded staleness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('record has staleness block', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('staleness');",
                  "    pm.expect(j.staleness.overall_status).to.eql('stale');",
                  "});",
                  "pm.test('raw_response preserved', () => {",
                  "    pm.expect(pm.response.json().raw_response).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/generations/{{battery_generation_id}}",
              "host": ["{{base_url}}"],
              "path": ["generations", "{{battery_generation_id}}"]
            }
          },
          "response": []
        }
      ]
    },
