    {
      "name": "3. Generate — LLM test cases",
      "item": [
        {
          "name": "Generate — Battery Life (force fresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('generation valid', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('battery_generation_id', j.id);",
                  "    pm.expect(j.status).to.eql('VALID');",
                  "    pm.expect(j.provider).to.eql('groq');",
                  "});",
                  "pm.test('has 3-5 test cases', () => {",
                  "    const tcs = pm.response.json().parsed.test_cases;",
                  "    pm.expect(tcs.length).to.be.within(3, 5);",
                  "});",
                  "pm.test('each test case has required fields', () => {",
                  "    const tcs = pm.response.json().parsed.test_cases;",
                  "    tcs.forEach(tc => {",
                  "        pm.expect(tc).to.have.property('title');",
                  "        pm.expect(tc).to.have.property('steps');",
                  "        pm.expect(tc).to.have.property('expected_result');",
                  "        pm.expect(tc.priority).to.be.oneOf(['low','medium','high','critical']);",
                  "    });",
                  "});",
                  "pm.test('prompt hash stored for idempotency', () => {",
                  "    pm.expect(pm.response.json().prompt_hash).to.be.a('string').with.lengthOf(64);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/selections/{{battery_selection_id}}/generate?force=true",
              "host": ["{{base_url}}"],
              "path": ["selections", "{{battery_selection_id}}", "generate"],
              "query": [{ "key": "force", "value": "true" }]
            }
          },
          "response": []
        },
        {
          "name": "Generate — Overpressure (force fresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('generation valid', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('overpressure_generation_id', j.id);",
                  "    pm.expect(j.status).to.eql('VALID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/selections/{{overpressure_selection_id}}/generate?force=true",
              "host": ["{{base_url}}"],
              "path": ["selections", "{{overpressure_selection_id}}", "generate"],
              "query": [{ "key": "force", "value": "true" }]
            }
          },
          "response": []
